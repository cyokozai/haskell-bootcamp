{
  "name": "Haskell",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.haskell",
        "justusadam.language-haskell",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "haskell.manageHLS": "PATH",
        "markdown.marp.themes": ["./lectures/section05/theme/cyokozai.css"],
        "markdown.marp.html": "all"
      }
    }
  },
  "mounts": [
    "source=haskell-cabal-store,target=/root/.cabal,type=volume"
  ],
  "postCreateCommand": "ghcup --version && ghc --version && cabal --version"
}